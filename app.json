{
  "expo": {
    "name": "Uchaaran Helper",
    "slug": "uchaaran-helper",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.uchaaran.helper",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Uchaaran Helper listens to your recitation so it can tell you how close it was to the ustaad’s."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.uchaaran.helper",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Uchaaran Helper listens to your recitation so it can tell you how close it was to the ustaad’s."
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "ff2c2753-f9e5-43b2-9be9-3004685f221e"
      }
    }
  }
}
