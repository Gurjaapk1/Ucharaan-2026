# BaniDB API base URL. Copy this file to .env and pick one.
# Expo only exposes variables prefixed EXPO_PUBLIC_ to app code, and inlines
# them at build time — restart `expo start` after changing this.

# Hosted BaniDB — no setup, no API key, and the only one a phone on Expo Go
# can reach out of the box.

# Local banidb-api (needs the Docker DB + `node app.js` running). A phone
# cannot reach your Mac's localhost — use the Mac's LAN IP instead.
# EXPO_PUBLIC_BANIDB_API_URL=http://localhost:3001/v2
